<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#4361ee">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="ReminderApp">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icons/icon-192.png">
    <title><%= title %> - Reminder App</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    
    <!-- Theme Init -->
    <script>
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
        // Register Service Worker (PWA)
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(() => {});
            });
        }
    </script>
</head>
<body>

    <!-- Splash Screen Intro -->
    <div id="splashScreen" class="splash-screen">
        <div class="splash-content">
            <i class="bi bi-mortarboard-fill splash-icon"></i>
            <h1 class="splash-title">ReminderApp</h1>
        </div>
    </div>

<% if (user) { %>
    <!-- Sidebar -->
    <%- include('sidebar') %>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Header -->
        <header class="top-header">
            <div class="d-flex align-items-center">
                <button class="btn border-0 d-md-none me-2 p-0 text-dark" id="sidebarToggle">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <h4 class="mb-0 fw-bold"><%= title %></h4>
            </div>
            <div class="user-profile">
                <!-- PWA Install Button -->
                <button id="pwaInstallBtn" class="btn btn-sm btn-primary d-none" title="Install Aplikasi" style="border-radius: 8px; font-size: 0.8rem;">
                    <i class="bi bi-download me-1"></i> <span class="d-none d-sm-inline">Install App</span>
                </button>
                <div class="d-flex flex-column text-end">
                    <span class="fw-bold"><%= user.nama %></span>
                    <small class="text-muted text-capitalize"><%= user.role %></small>
                </div>
                <div class="user-avatar">
                    <%= user.nama.charAt(0).toUpperCase() %>
                </div>
            </div>
        </header>

        <!-- Content Area -->
        <div class="content-area">
            <% if (error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3">
                    <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
<% } %>
