<%- include('../partials/header') %>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-eye text-primary me-2"></i> Draft Notifikasi Piket</h4>
        <p class="text-muted mb-0">Preview pesan yang akan dikirim ke grup WhatsApp untuk besok (<strong><%= besokDay %></strong>)</p>
    </div>
    <a href="/piket" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Kembali</a>
</div>

<div class="row">
    <!-- Draft Preview -->
    <div class="col-lg-6 mb-4">
        <div class="premium-card h-100">
            <div class="card-header border-0 bg-transparent pt-4 pb-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-whatsapp text-success me-2"></i> Preview Pesan WA</h5>
            </div>
            <div class="card-body">
                <div class="p-3 rounded-3" style="background-color: #128C7E; color: white; font-family: monospace; white-space: pre-wrap; font-size: 0.9rem; min-height: 300px; line-height: 1.6;">
                    <%= draft.replace(/\n/g, '<br>') %>
                </div>
                <form action="/api/send-reminder/piket" method="POST" class="mt-3">
                    <button type="submit" class="btn btn-success w-100 fw-bold" onclick="return confirm('Kirim notifikasi piket ini ke grup WA sekarang?')">
                        <i class="bi bi-send-fill me-2"></i> Kirim Sekarang ke Grup WA
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Ringkasan Penugasan -->
    <div class="col-lg-6 mb-4">
        <div class="premium-card h-100">
            <div class="card-header border-0 bg-transparent pt-4 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill text-warning me-2"></i> Pembagian Tugas</h5>
                    <% if (penugasan.length > 0) { %>
                        <span class="badge bg-success">Manual</span>
                    <% } else { %>
                        <span class="badge bg-secondary">Random</span>
                    <% } %>
                </div>
            </div>
            <div class="card-body">
                <!-- Jurnal -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;background:rgba(67,97,238,0.1);">
                            <i class="bi bi-journal-bookmark text-primary" style="font-size:1rem;"></i>
                        </div>
                        <span class="fw-bold">Ambil Jurnal & Hapus Papan</span>
                    </div>
                    <div class="ps-4">
                        <% if (role1) { %>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2"><i class="bi bi-person me-1"></i><%= role1 %></span>
                        <% } else { %>
                            <span class="text-muted fst-italic">Belum ditentukan</span>
                        <% } %>
                    </div>
                </div>

                <!-- Sapu Pagi -->
                <div class="mb-4">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;background:rgba(248,150,30,0.1);">
                            <i class="bi bi-sun text-warning" style="font-size:1rem;"></i>
                        </div>
                        <span class="fw-bold">Menyapu Pagi</span>
                    </div>
                    <div class="ps-4 d-flex flex-wrap gap-2">
                        <% if (role2.length > 0) { %>
                            <% role2.forEach(n => { %>
                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2"><i class="bi bi-person me-1"></i><%= n %></span>
                            <% }) %>
                        <% } else { %>
                            <span class="text-muted fst-italic">Belum ditentukan</span>
                        <% } %>
                    </div>
                </div>

                <!-- Sapu Sore -->
                <div class="mb-2">
                    <div class="d-flex align-items-center mb-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;background:rgba(247,37,133,0.1);">
                            <i class="bi bi-moon text-danger" style="font-size:1rem;"></i>
                        </div>
                        <span class="fw-bold">Menyapu Sore</span>
                    </div>
                    <div class="ps-4 d-flex flex-wrap gap-2">
                        <% if (role3.length > 0) { %>
                            <% role3.forEach(n => { %>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2"><i class="bi bi-person me-1"></i><%= n %></span>
                            <% }) %>
                        <% } else { %>
                            <span class="text-muted fst-italic">Belum ditentukan</span>
                        <% } %>
                    </div>
                </div>

                <hr class="my-3" style="border-color: var(--border-color);">
                <a href="/piket" class="btn btn-outline-primary w-100">
                    <i class="bi bi-pencil-square me-1"></i> Atur Penugasan Manual
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Daftar Siswa Piket Besok -->
<div class="premium-card">
    <div class="card-header border-0 bg-transparent pt-4 pb-0">
        <h5 class="mb-0 fw-bold"><i class="bi bi-people text-info me-2"></i> Daftar Siswa Piket Hari <%= besokDay %></h5>
    </div>
    <div class="card-body">
        <% if (piket.length === 0) { %>
            <p class="text-muted text-center py-4">Belum ada data siswa piket untuk hari <%= besokDay %>.</p>
        <% } else { %>
            <div class="d-flex flex-wrap gap-2">
                <% piket.forEach(p => { %>
                    <% const tugasnya = penugasan.find(pe => pe.nama_siswa === p.nama_siswa); %>
                    <div class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border" style="background-color: var(--bg-main);">
                        <i class="bi bi-person-circle text-primary"></i>
                        <span class="fw-bold"><%= p.nama_siswa %></span>
                        <% if (tugasnya) { %>
                            <span class="badge <%= tugasnya.tugas === 'jurnal' ? 'bg-primary' : tugasnya.tugas === 'sapu_pagi' ? 'bg-warning text-dark' : 'bg-danger' %>">
                                <%= tugasnya.tugas === 'jurnal' ? 'Jurnal' : tugasnya.tugas === 'sapu_pagi' ? 'Sapu Pagi' : 'Sapu Sore' %>
                            </span>
                        <% } else { %>
                            <span class="badge bg-secondary">Random</span>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
