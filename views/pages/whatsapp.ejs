<%- include('../partials/header') %>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="premium-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-whatsapp me-2"></i> Status Koneksi WhatsApp</span>
                    <% if (isReady) { %>
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Terhubung</span>
                    <% } else if (lastError) { %>
                        <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Error</span>
                    <% } else { %>
                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Menunggu</span>
                    <% } %>
                </div>
                <div class="card-body text-center py-5">
                    <% if (isReady) { %>
                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h4 class="mb-3">WhatsApp Berhasil Terhubung!</h4>
                        <p class="text-muted">Sistem sudah siap mengirimkan notifikasi otomatis.</p>
                        <a href="/settings" class="btn btn-primary mt-3">
                            <i class="bi bi-gear me-2"></i> Buka Pengaturan
                        </a>
                    <% } else if (lastError) { %>
                        <div class="mb-4">
                            <i class="bi bi-exclamation-octagon-fill text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h4 class="text-danger mb-3">Terjadi Kesalahan</h4>
                        <div class="alert alert-danger mb-4 text-start">
                            <code><%= lastError %></code>
                        </div>
                        <p class="text-muted small">Kemungkinan besar library browser (Chrome) tidak ditemukan atau tidak kompatibel dengan server.</p>
                        <button onclick="window.location.reload()" class="btn btn-primary mt-2">
                            <i class="bi bi-arrow-clockwise me-2"></i> Coba Lagi
                        </button>
                    <% } else if (qrImage) { %>
                        <h4 class="mb-4">Scan QR Code</h4>
                        <p class="text-muted mb-4">Scan kode di bawah ini dengan WhatsApp Anda:</p>
                        
                        <div class="qr-container p-3 bg-white d-inline-block rounded shadow-sm mb-4 border">
                            <img src="<%= qrImage %>" alt="WhatsApp QR Code" class="img-fluid" style="max-width: 300px;">
                        </div>
                        
                        <p class="text-muted small mb-0"><i class="bi bi-info-circle me-1"></i> QR akan otomatis diperbarui jika sudah kadaluarsa.</p>
                        
                        <button onclick="window.location.reload()" class="btn btn-outline-primary mt-4">
                            <i class="bi bi-arrow-clockwise me-2"></i> Cek Status Koneksi
                        </button>
                    <% } else { %>
                        <div class="py-3">
                            <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h4 class="mb-3">Menyiapkan Browser...</h4>
                            <p class="text-muted">Sedang menjalankan sistem WhatsApp di server. Proses ini bisa memakan waktu 1-2 menit pada saat pertama kali.</p>
                            <div class="alert alert-light border small text-start">
                                <i class="bi bi-terminal me-2"></i> <strong>Log Status:</strong><br>
                                <%= isInitializing ? 'Sedang inisialisasi browser...' : 'Menunggu antrean...' %>
                            </div>
                            <button onclick="window.location.reload()" class="btn btn-outline-primary mt-3">
                                <i class="bi bi-arrow-clockwise me-2"></i> Refresh Halaman
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .qr-container img {
        image-rendering: pixelated;
    }
</style>

<%- include('../partials/footer') %>
