<%- include('../partials/header') %>

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="premium-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-whatsapp me-2"></i> Status Koneksi WhatsApp</span>
                    <% if (isReady) { %>
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Terhubung</span>
                    <% } else { %>
                        <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i> Terputus</span>
                    <% } %>
                </div>
                <div class="card-body text-center py-5">
                    <% if (isReady) { %>
                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h4 class="mb-3">WhatsApp Berhasil Terhubung!</h4>
                        <p class="text-muted">Sistem sudah siap mengirimkan notifikasi tugas dan piket otomatis ke grup WhatsApp Anda.</p>
                        <a href="/settings" class="btn btn-primary mt-3">
                            <i class="bi bi-gear me-2"></i> Buka Pengaturan Notifikasi
                        </a>
                    <% } else if (qrImage) { %>
                        <h4 class="mb-4">Scan QR Code</h4>
                        <p class="text-muted mb-4">Silakan buka WhatsApp di ponsel Anda, lalu buka <strong>Perangkat Tertaut</strong> dan scan kode di bawah ini:</p>
                        
                        <div class="qr-container p-3 bg-white d-inline-block rounded shadow-sm mb-4">
                            <img src="<%= qrImage %>" alt="WhatsApp QR Code" class="img-fluid" style="max-width: 300px;">
                        </div>
                        
                        <div class="alert alert-info mt-3 text-start">
                            <ul class="mb-0 small">
                                <li>Pastikan koneksi internet ponsel stabil.</li>
                                <li>QR Code akan otomatis diperbarui jika tidak segera di-scan.</li>
                                <li>Setelah scan, halaman ini akan otomatis menunjukkan status "Terhubung" saat Anda refresh.</li>
                            </ul>
                        </div>
                        
                        <button onclick="window.location.reload()" class="btn btn-outline-primary mt-3">
                            <i class="bi bi-arrow-clockwise me-2"></i> Refresh Status
                        </button>
                    <% } else { %>
                        <div class="py-5">
                            <div class="spinner-border text-primary mb-3" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <h4 class="mb-3">Menyiapkan WhatsApp...</h4>
                            <p class="text-muted">Aplikasi sedang menginisialisasi browser. Silakan tunggu sebentar atau coba refresh halaman ini beberapa saat lagi.</p>
                            <button onclick="window.location.reload()" class="btn btn-outline-primary mt-3">
                                <i class="bi bi-arrow-clockwise me-2"></i> Cek Lagi
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .qr-container img {
        image-rendering: pixelated;
    }
</style>

<%- include('../partials/footer') %>
