                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Footer of Hero -->
        <div class="absolute left-0 right-0 z-20 border-t border-white/20 bg-black/40 backdrop-blur-sm" style="bottom: 5vh;">
            <div class="container mx-auto px-4 lg:px-8 py-2 lg:py-3 flex items-center justify-between">
