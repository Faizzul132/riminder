<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manajemen Kelas - Selamat Datang</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        
        html {
            filter: grayscale(100%) !important;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
            color: #09090b;
        }

        /* Animated Text Container */
        .animated-text-wrapper {
            position: relative;
            display: inline-flex;
            width: 100%;
            justify-content: center;
            overflow: hidden;
            vertical-align: top;
            height: 1.2em;
        }

        .animated-text {
            position: absolute;
            font-weight: 600;
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform: translateY(0);
            opacity: 1;
        }
    </style>
</head>
<body class="antialiased selection:bg-zinc-200 selection:text-zinc-900">

    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-zinc-200">
        <div class="container mx-auto px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-zinc-900 rounded flex items-center justify-center text-white font-bold">K</div>
                <span class="font-bold text-lg tracking-tight">KelasApp</span>
            </div>
            <nav class="hidden md:flex gap-6 text-sm font-medium text-zinc-600">
                <a href="#fitur" class="hover:text-zinc-900 transition-colors">Fitur</a>
                <a href="#tentang" class="hover:text-zinc-900 transition-colors">Tentang</a>
            </nav>
            <div>
                <a href="/login" class="inline-flex h-9 items-center justify-center rounded-md bg-zinc-900 px-4 py-2 text-sm font-medium text-zinc-50 shadow transition-colors hover:bg-zinc-900/90">
                    Masuk
                </a>
            </div>
        </div>
    </header>

    <main class="pt-16">
        <!-- HERO SECTION -->
        <div class="w-full">
            <div class="container mx-auto px-6">
                <div class="flex gap-8 py-20 lg:py-40 items-center justify-center flex-col text-center">
                    <div>
                        <a href="#fitur" class="inline-flex items-center justify-center whitespace-nowrap rounded-full bg-zinc-100 text-zinc-900 hover:bg-zinc-200/80 h-9 px-4 text-sm font-medium transition-colors gap-2 border border-zinc-200">
                            Pelajari peluncuran v2.0 <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                    
                    <div class="flex gap-4 flex-col items-center">
                        <h1 class="text-5xl md:text-7xl max-w-3xl tracking-tighter text-center font-normal text-zinc-900 leading-tight">
                            <span>Manajemen Kelas yang</span>
                            <span class="animated-text-wrapper md:pb-4 md:pt-1">
                                &nbsp;
                                <span id="animated-text" class="animated-text text-zinc-900">
                                    Cepat
                                </span>
                            </span>
                        </h1>

                        <p class="text-lg md:text-xl leading-relaxed tracking-tight text-zinc-500 max-w-2xl text-center mt-4">
                            Mengelola kelas saat ini sudah cukup sulit. Hindari kerumitan lebih lanjut dengan meninggalkan metode usang. Tujuan kami adalah menyederhanakan manajemen tugas dan piket, membuatnya lebih mudah dan cepat dari sebelumnya.
                        </p>
                    </div>
                    
                    <div class="flex flex-col sm:flex-row gap-3 mt-4">
                        <a href="#fitur" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium border border-zinc-200 bg-white hover:bg-zinc-100 hover:text-zinc-900 h-11 px-8 gap-2 transition-colors">
                            Lihat Fitur <i data-lucide="layout-grid" class="w-4 h-4"></i>
                        </a>
                        <a href="/login" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium bg-zinc-900 text-zinc-50 hover:bg-zinc-900/90 h-11 px-8 gap-2 transition-colors shadow">
                            Masuk Sekarang <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- FEATURES SECTION (Preserved) -->
        <section id="fitur" class="py-24 bg-zinc-50 border-t border-zinc-200">
            <div class="max-w-6xl mx-auto px-6">
                <div class="text-center mb-16 relative">
                    <h2 class="text-3xl md:text-4xl font-bold text-zinc-900 mb-4 tracking-tight">Fitur Utama KelasApp</h2>
                    <p class="text-zinc-500 max-w-2xl mx-auto text-lg leading-relaxed">Semua yang Anda butuhkan untuk mengelola kelas dengan efisien dan terorganisir.</p>
                </div>
                
                <div class="grid md:grid-cols-3 gap-8">
                    <!-- Feature 1 -->
                    <div class="bg-white p-8 border border-zinc-200 rounded-xl hover:shadow-md transition-all group">
                        <div class="w-12 h-12 mb-6 bg-zinc-100 text-zinc-900 rounded-lg flex items-center justify-center group-hover:bg-zinc-900 group-hover:text-white transition-colors">
                            <i data-lucide="check-square" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-bold text-zinc-900 mb-3 tracking-tight">Manajemen Tugas</h3>
                        <p class="text-zinc-500 leading-relaxed">Catat dan pantau tugas dari berbagai mata pelajaran. Jangan pernah lewatkan deadline lagi.</p>
                    </div>
                    
                    <!-- Feature 2 -->
                    <div class="bg-white p-8 border border-zinc-200 rounded-xl hover:shadow-md transition-all group">
                        <div class="w-12 h-12 mb-6 bg-zinc-100 text-zinc-900 rounded-lg flex items-center justify-center group-hover:bg-zinc-900 group-hover:text-white transition-colors">
                            <i data-lucide="calendar" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-bold text-zinc-900 mb-3 tracking-tight">Jadwal Piket</h3>
                        <p class="text-zinc-500 leading-relaxed">Atur dan kelola jadwal piket harian. Siswa dapat melihat tugas mereka langsung dari dashboard.</p>
                    </div>
                    
                    <!-- Feature 3 -->
                    <div class="bg-white p-8 border border-zinc-200 rounded-xl hover:shadow-md transition-all group">
                        <div class="w-12 h-12 mb-6 bg-zinc-100 text-zinc-900 rounded-lg flex items-center justify-center group-hover:bg-zinc-900 group-hover:text-white transition-colors">
                            <i data-lucide="message-square" class="w-6 h-6"></i>
                        </div>
                        <h3 class="text-xl font-bold text-zinc-900 mb-3 tracking-tight">Notifikasi WA</h3>
                        <p class="text-zinc-500 leading-relaxed">Pengingat otomatis via WhatsApp untuk tugas dan jadwal piket ke grup kelas setiap malam.</p>
                    </div>
                </div>
            </div>
        </section>
        
        <!-- CTA Section -->
        <section class="py-24 relative overflow-hidden bg-white border-t border-zinc-200 text-center">
            <div class="relative max-w-4xl mx-auto px-6 z-10">
                <h2 class="text-4xl font-bold text-zinc-900 mb-6 tracking-tight">Siap Memulai?</h2>
                <p class="text-zinc-500 text-lg mb-10 max-w-2xl mx-auto leading-relaxed">Bergabung dengan ribuan siswa dan guru yang telah merasakan kemudahan menggunakan KelasApp.</p>
                <a href="/login" class="inline-flex h-12 items-center justify-center rounded-md bg-zinc-900 px-8 text-base font-medium text-white transition-colors hover:bg-zinc-900/90 shadow-md">
                    Masuk Sekarang Secara Gratis
                </a>
            </div>
        </section>
    </main>
    
    <footer class="bg-white py-12 border-t border-zinc-200">
        <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center space-x-2">
                <div class="w-6 h-6 bg-zinc-900 rounded flex items-center justify-center text-white font-bold text-xs">K</div>
                <span class="font-bold text-lg text-zinc-900 tracking-tight">KelasApp</span>
            </div>
            <div class="text-zinc-500 text-sm">
                © 2026 KelasApp. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Initialize Icons
        lucide.createIcons();

        // Animated Text Logic
        const titles = ["Cepat", "Mudah", "Modern", "Efisien", "Praktis"];
        let currentIndex = 0;
        const textElement = document.getElementById("animated-text");

        setInterval(() => {
            // Animate out (slide up)
            textElement.style.transform = "translateY(-150%)";
            textElement.style.opacity = "0";
            
            setTimeout(() => {
                // Change text, move to bottom instantly without transition
                currentIndex = (currentIndex + 1) % titles.length;
                textElement.innerText = titles[currentIndex];
                textElement.style.transition = "none";
                textElement.style.transform = "translateY(150%)";
                
                // Force reflow to apply the instant move
                void textElement.offsetWidth;
                
                // Animate in (slide to center)
                textElement.style.transition = "all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275)";
                textElement.style.transform = "translateY(0)";
                textElement.style.opacity = "1";
            }, 500); // Wait for animate out to finish
        }, 2500);
    </script>
</body>
</html>
