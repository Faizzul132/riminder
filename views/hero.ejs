                    <div class="flex gap-1">
                        <div class="w-1 h-1 bg-white/60 rounded-full animate-pulse"></div>
                        <div class="w-1 h-1 bg-white/40 rounded-full animate-pulse" style="animation-delay: 0.2s;"></div>
                        <div class="w-1 h-1 bg-white/20 rounded-full animate-pulse" style="animation-delay: 0.4s;"></div>
                    </div>
                    <span class="hidden lg:inline">FRAME: ∞</span>
                </div>
            </div>
        </div>
    </main>

    <!-- Features Section (Adapted to Dark Theme to match Hero) -->
